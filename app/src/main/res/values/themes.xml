<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MemoryKiller17.OneUI9" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/oneui_blue</item>
        <item name="android:windowBackground">@color/oneui_bg</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>

    <style name="TextAppearance.OneUI9.ExpandedTitle" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:textSize">28sp</item>
        <item name="android:textColor">@color/oneui_text_primary</item>
        <item name="android:fontFamily">sans-serif-light</item>
    </style>

    <style name="TextAppearance.OneUI9.CollapsedTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/oneui_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
